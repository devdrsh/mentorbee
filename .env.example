# ==============================================================================
# MENTORBEE CLASS LINK MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Security Secret Key (Generate a random 32+ char string in production)
SECRET_KEY=change_this_to_a_secure_random_key_in_production_xyz123

# Database Connection URL (SQLite default, or PostgreSQL / MySQL)
# SQLite:
DATABASE_URL=sqlite:///./mentorbee.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mentorbee

# Server Port (Default: 8000, cloud hosts override with $PORT)
PORT=8000
